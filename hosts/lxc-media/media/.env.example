# lxc-media .env — NEVER commit .env to git
TZ=America/Toronto
PUID=1000
PGID=1000

# Jellyfin published URL — your LAN IP
JELLYFIN_PUBLISHED_URL=http://10.0.0.105

# NOTE: qBittorrent default login is admin/adminadmin. Change on first boot!
# NOTE: All arr stack API keys are generated by each app on first boot.
# Settings > General and add to lxc-infra/.env for Homepage to work too. 
